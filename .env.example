###############################################################################
# SECTION 1 - LOCAL DEVELOPMENT
###############################################################################
# Copy ONLY this section into .env for Docker/local development. Replace the
# placeholder secrets with local or Stripe sandbox values. Do not copy Section 2
# into the same .env file because duplicate production keys would override these.

# Django and product
SECRET_KEY=replace-with-a-long-random-development-secret
PLATFORM_NAME=Gather HQs
PLATFORM_LONG_NAME=Gather Headquarters
PLATFORM_DOMAIN=localhost
PLATFORM_CONTROL_HOSTS=localhost,www.localhost
PLATFORM_DEFAULT_CURRENCY=usd

# Gather HQs subscription billing - Stripe sandbox
STRIPE_STANDARD_MONTHLY_PRICE_ID=price_1TyGKX2dujKmWAFggUOrejZz
STRIPE_STANDARD_YEARLY_PRICE_ID=price_1TyGKX2dujKmWAFgx9MQuP3R
STRIPE_STANDARD_MONTHLY_LOOKUP_KEY=standard_monthly
STRIPE_STANDARD_YEARLY_LOOKUP_KEY=standard_yearly
STANDARD_MONTHLY_AMOUNT_CENTS=2000
STANDARD_YEARLY_AMOUNT_CENTS=22000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
TICKET_APPLICATION_FEE_BPS=300
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=7
SUSPENDED_DATA_RETENTION_DAYS=90

# Local web and security
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
TRUST_X_FORWARDED_PROTO=false
LOG_FORMAT=plain
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Local PostgreSQL - Docker Compose uses these individual values
DATABASE_URL=
DB_NAME=event_management
DB_USER=event_management
DB_PASSWORD=replace-with-a-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Local Redis and Celery
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1

# Local email, messaging, and reviews
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
SUPPORT_EMAIL=support@gatherhqs.com
EMAIL_DELIVERY_BACKEND=django
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMS_DELIVERY_BACKEND=disabled
COMMUNICATIONS_WEBHOOK_SECRET=
SMS_MONTHLY_SEGMENT_LIMIT=0
CAMPAIGN_EXPANSION_BATCH_SIZE=500
CAMPAIGN_DELIVERY_BATCH_SIZE=100
REVIEW_TOKEN_MAX_AGE_DAYS=365

# Local operations and rate limiting
HEALTHCHECK_REQUIRE_BACKGROUND_WORKERS=false
BACKGROUND_HEARTBEAT_MAX_AGE_SECONDS=180
PUBLIC_WRITE_RATE_LIMIT_MAX=30
PUBLIC_WRITE_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_TRUSTED_PROXY_COUNT=0

# Local media uses the filesystem
MEDIA_STORAGE_BACKEND=filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_AUTH=true


###############################################################################
# SECTION 2 - RENDER PRODUCTION
###############################################################################
# This is the complete Render production reference. The render.yaml Blueprint
# automatically adds the non-secret values below. During initial Blueprint
# creation, Render prompts you only for the values marked "ENTER IN RENDER".
# Never commit real secrets to this file.
#
# Do not paste this entire file into Render. Select Section 2 only, and do not
# manually add the five commented Render-managed values.

# Render-managed values - DO NOT ADD OR OVERRIDE MANUALLY
# SECRET_KEY=<generated automatically by Render>
# DATABASE_URL=<linked automatically to gather-hqs-db>
# REDIS_URL=<linked automatically to gather-hqs-key-value>
# CELERY_BROKER_URL=<linked automatically to gather-hqs-key-value>
# PORT=<assigned automatically by Render>

# Production application and domain - managed by render.yaml
DJANGO_SETTINGS_MODULE=config.Settings.prod
PLATFORM_NAME=Gather HQs
PLATFORM_LONG_NAME=Gather Headquarters
PLATFORM_DOMAIN=gatherhqs.com
PLATFORM_CONTROL_HOSTS=gatherhqs.com,www.gatherhqs.com
PLATFORM_DEFAULT_CURRENCY=usd
ALLOWED_HOSTS=gatherhqs.com,www.gatherhqs.com,.gatherhqs.com,gather-hqs-web.onrender.com
CSRF_TRUSTED_ORIGINS=https://gatherhqs.com,https://www.gatherhqs.com,https://*.gatherhqs.com,https://gather-hqs-web.onrender.com

# Production billing values - managed by render.yaml
STRIPE_STANDARD_MONTHLY_LOOKUP_KEY=standard_monthly
STRIPE_STANDARD_YEARLY_LOOKUP_KEY=standard_yearly
STANDARD_MONTHLY_AMOUNT_CENTS=2000
STANDARD_YEARLY_AMOUNT_CENTS=22000
TICKET_APPLICATION_FEE_BPS=300
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=7
SUSPENDED_DATA_RETENTION_DAYS=90

# ENTER IN RENDER - use one matching Stripe mode for every value
STRIPE_STANDARD_MONTHLY_PRICE_ID=replace-with-matching-mode-monthly-price-id
STRIPE_STANDARD_YEARLY_PRICE_ID=replace-with-matching-mode-yearly-price-id
STRIPE_SECRET_KEY=replace-with-matching-mode-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-platform-webhook-signing-secret
STRIPE_CONNECT_WEBHOOK_SECRET=replace-with-connect-webhook-signing-secret
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=replace-with-matching-mode-portal-configuration-id

# Production security, logging, and process values - managed by render.yaml
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
TRUST_X_FORWARDED_PROTO=true
LOG_FORMAT=json
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
DB_CONN_MAX_AGE=60
WEB_CONCURRENCY=2

# Production email - non-secret values are managed by render.yaml
EMAIL_DELIVERY_BACKEND=resend
EMAIL_BACKEND=communications.email_backend.ResendEmailBackend
DEFAULT_FROM_EMAIL="Gather HQs <events@gatherhqs.com>"
SUPPORT_EMAIL=support@gatherhqs.com

# ENTER IN RENDER - Resend secrets
RESEND_API_KEY=replace-with-resend-api-key
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-signing-secret

# Production SMS, campaigns, and reviews - managed by render.yaml
SMS_DELIVERY_BACKEND=disabled
SMS_MONTHLY_SEGMENT_LIMIT=0
CAMPAIGN_EXPANSION_BATCH_SIZE=500
CAMPAIGN_DELIVERY_BATCH_SIZE=100
REVIEW_TOKEN_MAX_AGE_DAYS=365

# Production operations and rate limiting - managed by render.yaml
HEALTHCHECK_REQUIRE_BACKGROUND_WORKERS=true
BACKGROUND_HEARTBEAT_MAX_AGE_SECONDS=180
PUBLIC_WRITE_RATE_LIMIT_MAX=30
PUBLIC_WRITE_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_TRUSTED_PROXY_COUNT=1

# Production object storage - backend values are managed by render.yaml
MEDIA_STORAGE_BACKEND=s3
AWS_QUERYSTRING_AUTH=true

# ENTER IN RENDER - S3-compatible private media storage
AWS_STORAGE_BUCKET_NAME=replace-with-private-media-bucket
AWS_S3_REGION_NAME=replace-with-bucket-region-or-leave-blank
AWS_S3_ENDPOINT_URL=replace-with-provider-endpoint-or-leave-blank-for-aws
AWS_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
AWS_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-key
