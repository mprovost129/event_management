# Required application secret. Generate a long random value for every environment.
SECRET_KEY=replace-with-a-long-random-secret

# Product placeholders; change when the name, domain, currency, and price are set.
PLATFORM_NAME=Event Management Platform
PLATFORM_DOMAIN=localhost
PLATFORM_DEFAULT_CURRENCY=usd
STRIPE_PLATFORM_PRICE_ID=
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=7
SUSPENDED_DATA_RETENTION_DAYS=90

# Web/security
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
TRUST_X_FORWARDED_PROTO=true
LOG_FORMAT=plain
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
DB_NAME=event_management
DB_USER=event_management
DB_PASSWORD=replace-with-a-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis
REDIS_URL=redis://redis:6379/1

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# Local development uses the filesystem. Production must use s3.
MEDIA_STORAGE_BACKEND=filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_AUTH=true
